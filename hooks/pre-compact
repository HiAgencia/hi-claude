#!/usr/bin/env bash
# PreCompact hook for hi-claude: the last chance to persist the thread before
# the context is squashed. Never blocks.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/json-lib"

emit_context PreCompact "Before compacting: bring docs/ROADMAP.md up to date. In the block between the hi-claude:en-curso markers, leave every open piece of work with one line for what is missing and one line for what is already resolved. After compaction that section is the only thing left of this thread. No dates, and do not turn it into a log."
exit 0
