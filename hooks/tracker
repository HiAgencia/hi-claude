#!/usr/bin/env bash
# PostToolUse for hi-claude: records which files this session changed, so the closer can demand the
# register be current once the change is worth it.
#
# State is ONE marker file per session under the temp dir: no dependency, nothing written into the
# user's project, and it dies with the machine's temp. Writing the register CLEARS the marker, which
# is what makes the rule "every change updates the register" checkable instead of hoped for.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/json-lib"

input=$(cat)
tool=$(json_str "$input" tool_name)
session=$(json_str "$input" session_id)
file_path=$(json_str "$input" file_path)
# The TURN key, for the per-turn consultation the guardian keys on. Absent, both fall back to their
# per-write behaviour, which is the safe direction.
prompt_id=$(json_str "$input" prompt_id)

[ -n "$session" ] || exit 0

case "$tool" in
  Write|Edit|NotebookEdit) ;;
  *) exit 0 ;;
esac

real=$(printf '%s' "$file_path" | tr '\\' '/' | sed 's#//*#/#g')
norm=$(printf '%s' "$real" | tr '[:upper:]' '[:lower:]')
marker="${TMPDIR:-/tmp}/hi-claude-turn-${session}"

# THE REGISTER IS THE ONE THE SESSION START INJECTS, and no other file that happens to share its name.
# A register under a dependency, a build output, a fixture or git's own directory is a way to silence
# the close without closing anything. Deriving the candidates from `cwd` - exactly as `session-start`
# does - makes the two hooks agree BY CONSTRUCTION: what the start injects is what the close accepts.
# Without a `cwd` in the payload it falls back to the conservative pattern, never to the broad one.
cwd=$(json_str "$input" cwd)
cwd=$(printf '%s' "$cwd" | sed 's#\\\\#\\#g' | tr '\\' '/' | sed 's#//*#/#g' | sed 's#/$##')
low=""; reg_docs=""; reg_root=""; est_docs=""; est_root=""; est_alt=""
if [ -n "$cwd" ]; then
  low=$(printf '%s' "$cwd" | tr '[:upper:]' '[:lower:]')
  reg_docs="${low}/docs/roadmap.md"; reg_root="${low}/roadmap.md"
  est_docs="${low}/docs/estado.md"; est_alt="${low}/docs/state.md"; est_root="${low}/estado.md"
fi

# AND IT MIRRORS THE START'S SEARCH, INCLUDING ONE LEVEL DOWN. A workspace that HOLDS repos keeps its
# register one level in, and `session-start` injects it from there. Deriving both from `cwd` is only
# an agreement if both derive the SAME set.
is_register=""
if [ -n "$cwd" ]; then
  case "$norm" in
    "$reg_docs"|"$reg_root") is_register="yes" ;;
    "${low}"/*)
      rel="${norm#${low}/}"
      d="${rel%%/*}"
      case "$d" in
        # A dependency, a build output and git's own directory ship registers that are not this one.
        node_modules|vendor|third_party|.venv|venv|site-packages|.git|dist|build|target|.tox) ;;
        *)
          case "${rel#*/}" in roadmap.md|docs/roadmap.md) is_register="yes" ;; esac ;;
      esac ;;
  esac
else
  case "$norm" in */docs/roadmap.md) is_register="yes" ;; esac
fi

# Writing the register, the live picture, the inventory, CLAUDE.md or memory settles the debt.
if [ -n "$is_register" ]; then
    rm -f "$marker" 2>/dev/null

    # BELONGING signal. A healthy register OSCILLATES: work comes in, work closes, it goes up and it
    # goes down. Monotony is the signal, not size: it depends on neither the item format nor the
    # writing style. It fires once and resets, because a signal repeated every turn is one that gets
    # learnt away.
    #
    # The counter is keyed by the REGISTER, not by the session: monotony is a property of the file
    # ACROSS sessions, so its counter has to outlive one. `cksum` emits "<crc> <bytes>", and keeping
    # BOTH digit runs means a collision needs the same CRC32 *and* the same path length. If the binary
    # is missing, the fallback stays keyed by the REGISTER - falling back to the session would restore
    # a threshold no single session reaches, without saying so.
    key=$(printf '%s' "$norm" | cksum 2>/dev/null | tr -cd '0-9' | cut -c1-16)
    [ -n "$key" ] || key=$(printf '%s' "$norm" | tr -c 'a-z0-9' '-' | tail -c 60)
    reg="${TMPDIR:-/tmp}/hi-claude-reg-${key}"
    # Per-section snapshot, taken when the window OPENS. What gets named is the section where the
    # growth LANDED, not the biggest one: with a handful of sections the largest holds a large share
    # by arithmetic, which is structure and not signal.
    sections() {
      awk '/^## /{ h=$0; sub(/^##[[:space:]]*/,"",h); next }
           h!=""{ b[h]+=length($0)+1 }
           END{ for (k in b) printf "%d\t%s\n", b[k], k }' "$1" 2>/dev/null
    }
    snap="${reg}.sec"
    # The `-f` test comes first because `2>/dev/null` on the COMMAND does not silence the SHELL's own
    # redirection error: on a path that is not there, the hook prints to stderr while behaving fine.
    cur=""
    [ -f "$real" ] && cur=$(wc -c < "$real" 2>/dev/null | tr -d ' ')
    if [ -n "$cur" ]; then
      [ -s "$reg" ] || sections "$real" > "$snap" 2>/dev/null
      printf '%s\n' "$cur" >> "$reg" 2>/dev/null
      # Twenty writes without the signal means the register oscillates, which is the healthy shape.
      # Start a FRESH window - samples and snapshot together - instead of trimming the samples alone:
      # trimming leaves the snapshot older than the samples it gets compared against.
      lines=$(wc -l < "$reg" 2>/dev/null | tr -d ' ')
      if [ -n "$lines" ] && [ "$lines" -gt 20 ]; then
        printf '%s\n' "$cur" > "$reg" 2>/dev/null
        sections "$real" > "$snap" 2>/dev/null
      fi
      ups=0; steps=0; prev=""
      for s in $(tail -n 5 "$reg" 2>/dev/null); do
        if [ -n "$prev" ]; then
          steps=$((steps + 1))
          [ "$s" -gt "$prev" ] && ups=$((ups + 1))
        fi
        prev="$s"
      done
      if [ "$steps" -ge 4 ] && [ "$ups" -ge 4 ]; then
        first=$(tail -n 5 "$reg" 2>/dev/null | head -n 1)
        top=""
        if [ -s "$snap" ]; then
          sections "$real" > "${snap}.now" 2>/dev/null
          top=$(awk -F'\t' '
            NR==FNR { old[$2]=$1; next }
            { d=$1 - (($2 in old) ? old[$2] : 0); if (d>0) printf "%d\t%s\n", d, $2 }' \
            "$snap" "${snap}.now" 2>/dev/null | sort -rn | head -2 \
            | awk -F'\t' '{ printf "%s%.70s (+%d ch)", (NR>1 ? "; " : ""), $2, $1 }')
          rm -f "${snap}.now" 2>/dev/null
        fi
        [ -n "$top" ] && top=" That growth landed in: ${top}."
        : > "$reg" 2>/dev/null; rm -f "$snap" 2>/dev/null
        emit_context PostToolUse "hi-claude: the register only GREW across the last 4 turns that touched it (${first} -> ${cur} bytes). A healthy register oscillates - work comes in, work closes, it goes up and down.${top} The context a register carries is TEMPORARY: it lives while its item is OPEN and goes when the item closes. Whatever outlives the item is not pending - it belongs to the context document, and moving it there is not pruning. Read that section before proposing anything: a section can be large and entirely alive, and what decides is whether its content is still OPEN WORK."
        exit 0
      fi
    fi
    exit 0
fi

# The live picture is derived the same way and for the same reason: a `state.md` inside a dependency
# is not this project's live picture, and accepting it settles a debt nothing closed.
if [ -n "$cwd" ]; then
  case "$norm" in
    "$est_docs"|"$est_alt"|"$est_root"|"${low}/state.md")
      rm -f "$marker" 2>/dev/null; exit 0 ;;
  esac
fi

case "$norm" in
  */docs/estado.md|*/docs/state.md)
    [ -z "$cwd" ] && { rm -f "$marker" 2>/dev/null; exit 0; } ;;
esac

case "$norm" in
  # A governed write that SUCCEEDED is a write the user confirmed - PostToolUse does not run otherwise.
  # That is what makes this the right place to keep the turn's count and the turn's batch mark.
  *claude.md|*claude.local.md)
    rm -f "$marker" 2>/dev/null
    [ -n "$prompt_id" ] && [ -n "$session" ] || exit 0
    gov="${TMPDIR:-/tmp}/hi-claude-gov-${session}-${prompt_id}"
    printf '.\n' >> "$gov" 2>/dev/null
    n=$(wc -l < "$gov" 2>/dev/null | tr -d ' ')
    # Fires on the SECOND and only the second: the first has nothing to group with, and one that
    # repeats on every edit afterwards is one that gets learnt away.
    [ "${n:-0}" = "2" ] && emit_context PostToolUse "hi-claude: that is the SECOND separate edit to a governed file this turn, and every one of them costs the user another confirmation dialog. Whatever else this file still needs, compose it and apply it in ONE write - a whole file is more reviewable than a fragment, not less."
    exit 0 ;;
  */memory/*.md)
    rm -f "$marker" 2>/dev/null
    # The batch mark: the consultation the user just approved listed the whole turn's memories, so the
    # rest of the turn rides it. Keyed by session AND turn, which is what lets the closer clear it.
    [ -n "$prompt_id" ] && [ -n "$session" ] || exit 0
    : > "${TMPDIR:-/tmp}/hi-claude-mem-${session}-${prompt_id}" 2>/dev/null
    exit 0 ;;
  */docs/inventario.md|*/docs/inventory.md|*/docs/skills.md|*/docs/mcp.md|*/docs/plugins.md|*/docs/tools.md)
    rm -f "$marker" 2>/dev/null; exit 0 ;;
  # The context document and the index settle the debt for the same reason: MOVING something to where
  # it belongs, or correcting the index after a document left the tree through the shell, closes the
  # loop exactly as writing a new line would. Without them a turn that pruned or moved stayed in debt
  # and the cheapest way out was to add a line - the accumulation incentive, pointing the wrong way.
  */docs/contexto.md|*/docs/context.md|*/docs/index.md)
    rm -f "$marker" 2>/dev/null; exit 0 ;;
esac

# A temporary destination is not "the system".
case "$norm" in
  /tmp/*|/var/tmp/*|*/appdata/local/temp/*|*/scratchpad/*|*.tmp) exit 0 ;;
esac

# ONE LINE PER FILE, not per write. The closer counts the lines of this marker and calls them
# "file(s)", and its threshold reads that number - the count has to mean what the message says.
grep -qxF "$norm" "$marker" 2>/dev/null \
  || printf '%s\n' "$norm" >> "$marker" 2>/dev/null

# CURRENCY signal. One open plan at a time: a plan whose work already shipped leaves the tree - git
# keeps it - and a second one written beside it turns the directory into a pile of expired claims.
#
# The test is UNTICKED BOXES, not the word "vigente"/"current": the signal has to hold in any language
# the maintainers write in. It never blocks, and it stays narrow on purpose - it only fires while
# writing INTO a plans/ or specs/ directory that already holds another document presenting itself as
# open. A signal that shows up on ordinary work is one that gets learnt away.
case "$norm" in
  */plans/*.md|*/specs/*.md)
    dir=$(dirname "$real")
    others=0
    for other in "$dir"/*.md; do
      [ -f "$other" ] || continue
      [ "$other" = "$real" ] && continue
      grep -q '^[[:space:]]*[-*] \[ \]' "$other" 2>/dev/null && others=$((others + 1))
    done
    if [ "$others" -ge 1 ]; then
      emit_context PostToolUse "hi-claude: ${others} other document(s) in $(basename "$dir")/ still carry unticked boxes, which presents them as open work. One open plan at a time. Check by EFFECT whether that work already shipped - the code, the version, the runnable criterion, never the boxes themselves. If it shipped, the document LEAVES THE TREE (git keeps it): it is not archived, not ticked, not renamed. Propose it to the user; nothing is deleted without their word."
    fi ;;
esac
exit 0
