#!/usr/bin/env bash
# Stop hook for hi-claude: a block of work that changed the system does not end with the register stale.
#
# The FIRST question is what stopped being true, not what is missing: when every destination asks for a
# new line, adding one is the cheapest way to settle the debt, and a register fills with claims that
# expired. Deleting settles it exactly as writing does. What the turn itself produced is exempt from
# pruning: that reading needs closing evidence before it authorises deleting anything.
#
# THE DEBT ACCUMULATES UNTIL IT IS WORTH A BLOCK. The marker holds one line per changed FILE and is
# keyed by SESSION, so a turn below the threshold passes and leaves it in place; the block lands when
# the session has gathered MIN_FILES without touching the register. A demand raised over one file
# mostly finds nothing to do, and a demand that mostly finds nothing gets answered without looking.
# The evidence behind the threshold lives in the maintainers' eval reports, not here.
#
# CONTRACT: `decision` and `reason` are TOP-LEVEL for Stop - NOT a hookSpecificOutput envelope, which
# is the union PreToolUse and SessionStart use. Getting this wrong fails schema validation and the
# hook is dropped without any error the user would notice.
#
# It blocks ONCE per cycle: the marker is cleared as it blocks, and `stop_hook_active` is honoured, so
# a second stop in the same cycle always passes. A guarantee that traps the user is not a guarantee.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/json-lib"

input=$(cat)
session=$(json_str "$input" session_id)
[ -n "$session" ] || exit 0

marker="${TMPDIR:-/tmp}/hi-claude-turn-${session}"

# The turn's per-consultation marks die with the turn. They are keyed by session AND turn precisely so
# this line can bound them: without it they accumulate in the temp dir for the life of the machine.
rm -f "${TMPDIR:-/tmp}/hi-claude-mem-${session}-"* "${TMPDIR:-/tmp}/hi-claude-gov-${session}-"* \
      "${TMPDIR:-/tmp}/hi-claude-md-${session}-"* 2>/dev/null

[ -f "$marker" ] || exit 0

# Already inside a stop-hook cycle: never block twice.
case "$input" in
  *'"stop_hook_active": true'*|*'"stop_hook_active":true'*)
    rm -f "$marker" 2>/dev/null; exit 0 ;;
esac

MIN_FILES=3
count=$(wc -l < "$marker" 2>/dev/null | tr -d ' ')
# Below the threshold the marker STAYS: the debt is deferred, not forgiven.
[ "${count:-0}" -ge "$MIN_FILES" ] || exit 0
rm -f "$marker" 2>/dev/null

printf '{\n  "decision": "block",\n  "reason": "%s"\n}\n' "$(escape_for_json \
"hi-claude: this session changed ${count} file(s) and left the register untouched. Close the loop, one line each, IN THIS ORDER: (1) WHAT STOPPED BEING TRUE because of this change - the doc, the comment, the rule or the item that describes the flow you just replaced. It gets corrected or DELETED where it lives; DELETING CLOSES THE LOOP EXACTLY AS WRITING DOES, and a closed item is deleted, never ticked. (2) WHAT IS NOT IN ITS PLACE - context that outlives the item it was written under, one subject split across two files, a document no CLAUDE.md declares. MOVING IS NOT PRUNING, so it is not held back by the rule below. (3) docs/ROADMAP.md - what is missing and what is already resolved. (4) ONLY IF IT CHANGED: the live picture when what EXISTS changed, the inventory when a tool came or went, memory when the user stated a preference or a limit, CLAUDE.md when a rule of the project changed. Verify by EFFECT: measure what is true now, never correct one text against another. WHAT THIS TURN PRODUCED IS NOT PRUNED IN THIS TURN - mark it and prune it when its closing evidence lands. Whatever does not apply, say so in one line and finish.")"
exit 0
