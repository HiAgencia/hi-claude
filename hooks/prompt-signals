#!/usr/bin/env bash
# UserPromptSubmit for hi-claude: some things the user says have a protocol behind them, and a skill
# description is not enough to reach it.
#
# A stall, a preference stated in passing, a failure reported for the second time, "this never happened
# before", "I already told you": each is a moment where nothing FEELS like it needs a skill, so the
# trigger cannot live in a description. It lives here, where the phrasing is literal and the match is
# deterministic. A regex does not correlate across languages - it matches what is written in it - so
# every signal carries its phrasings in Spanish and in English.
#
# CONTRACT: hookSpecificOutput.additionalContext with hookEventName "UserPromptSubmit". The field is
# `prompt`; `prompt_text` is kept as a fallback: it costs one line, and assuming a field name and being
# wrong fails in total silence.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/json-lib"

input=$(cat)

prompt=$(json_str "$input" prompt)
[ -z "$prompt" ] && prompt=$(json_str "$input" prompt_text)
[ -n "$prompt" ] || exit 0

lower=$(printf '%s' "$prompt" | tr '[:upper:]' '[:lower:]')
has() { printf '%s' "$lower" | grep -Eq "$1"; }

# --- a stall or a closed verdict ---
# Deliberately narrow. "this test fails, fix it" and "I'm missing a dependency" are ordinary work,
# not a stall - the harness carries both as negatives and they must stay silent.
if has 'algo anda mal|no s[eé] qu[eé] (pasa|est|hay)|estamos estancad|seguimos estancad|no mejora (nada|nunca)|qu[eé] se nos (est[aá] )?escapa|revis[aá] todo de nuevo|no se puede|es imposible|no hay (forma|manera|caso)|nada funciona|we.?re stuck|are we missing|something.?s off|nothing is improving|take another look|it (can.?t|cannot) be done|no way to do'
then
  emit_context UserPromptSubmit "hi-claude: this reads as a quality stall or a closed verdict, and it has a protocol. There is no \"it cannot be done\" - there is an angle not tried yet. Do NOT answer with a conclusion: use the hi-claude:seeding-doubts skill to manufacture the angle. Its deliverable is MORE DOUBTS with their evidence, ordered by damage x cost, whatever is already shipped first; every checkable one gets verified on the spot, and a doubt refuted WITH data is worth as much as a confirmed one."
  exit 0
fi

msg=""

# --- a failure that PERSISTS ---
# Narrow on purpose: a first report of a failing test is ordinary work and stays silent. What is matched
# is the failure that came back, which is the moment a third hypothesis gets tried instead of the first
# file getting opened.
if has 'sigue (fallando|sin (andar|funcionar)|igual|pasando)|sigue roto|falla de nuevo|volvi[oó] a fallar|otra vez (falla|fall[oó]|no (anda|funciona))|todav[ií]a (falla|no (anda|funciona))|still (fail|broken|not working|doesn.?t work)|keeps failing|fails again|failed again|(it.?s|is) broken again'
then
  msg="${msg}hi-claude: this failure CAME BACK. Before another hypothesis: OPEN the files that take part, whole, and compare them with each other - the piece that writes, the one that merges, the one that consumes, and their tests. Theorising is allowed only IN ADDITION to reading; comparing two outputs and deducing the cause is the effect standing in for the cause. A fix made on the piece where the symptom showed is the next pass, not a fix. "
fi

# --- "this never happened to me" ---
if has 'nunca me (hab[ií]a )?pas[oó]|esto nunca (me )?pas|jam[aá]s me pas[oó]|en (mis )?otros proyectos (no|nunca)|never happened (to me )?before|never seen this before|(it )?never did this before|in my other projects'
then
  msg="${msg}hi-claude: \"this never happened before\" is a signal to COMPARE, not a doubt to explain away. Stop justifying the default and look for the difference: which library, plugin or setting is here that was not there, checked against the official docs. It may end in \"something here should change\", \"this behaviour is the right one\" or \"the difference is real and wanted\" - say which, with the evidence. "
fi

# --- the user is REPEATING themselves ---
if has 'ya te (lo )?dije|te lo (dije|expliqu[eé]|ped[ií])|te (dije|expliqu[eé]|ped[ií]) (mil|varias|muchas|tres|3) veces|cu[aá]ntas veces (te|lo|m[aá]s|tengo|hay que)|otra vez (lo mismo|con lo mismo)|de nuevo lo mismo|i (already )?told you|how many times (do i|have i|must i|did i)|same (mistake|thing) again'
then
  msg="${msg}hi-claude: the user is REPEATING something, and making them repeat is the failure. Two things, now: (1) what they point at is a PATTERN, never one occurrence - fix it where they saw it, name the pattern in a sentence that does not mention the case, sweep ALL the material for it by SHAPE, and report what was swept and what turned up, zero included; (2) a rule explained for the third time gets PROPOSED for the CLAUDE.md it belongs to in this same turn, through hi-claude:memory-protocol. Writing the rule down is not applying it. "
fi

# --- a DURABLE preference, limit or correction ---
# NARROW ON PURPOSE: the negatives are traps built from the SAME words as the positives - "no me gusta
# cómo quedó este párrafo" against "no me gusta que uses tablas largas, de ahora en más"; "recordame
# mañana" against "recordá que jamás". The difference is DURABLE vs one-off, which is semantic, so only
# the unambiguously durable forms are matched here; a user profile or a project datum carries no
# durable marker at all, and a description is what has to catch those.
if has 'de ahora en m[aá]s|de aqu[ií] en (m[aá]s|adelante)|para la pr[oó]xima|nunca m[aá]s|record[aá] que|qued[oa]mos en|me corrijo|tenelo presente|ten[ée]lo en cuenta|from now on|for next time|never again|i prefer that|going forward|s[ií],? exactamente|perfecto,? as[ií]|yes,? exactly'
then
  msg="${msg}hi-claude: this reads as a DURABLE preference, limit or correction - not a one-off request. It has a protocol: hi-claude:memory-protocol. Classify it against the admission axis (PREFERENTIAL, LIMITING, TIMELESS), and if it qualifies PROPOSE the exact memory before writing anything - persistent memory and CLAUDE.md never change without the user's explicit approval, and a guard enforces it. If it does NOT qualify, say nothing about it and carry on: a one-off instruction is not memory. Creating a new memory is the LAST option - if one already carries the rule, extend THAT one. If SEVERAL qualify, propose them ALL in ONE consultation: the approval covers the turn, seeing them side by side is what shows which two are the same rule, and what was not listed was not approved. A change to CLAUDE.md goes in ONE write for the same reason - every separate edit costs the user another confirmation."
fi

[ -n "$msg" ] && emit_context UserPromptSubmit "$msg"
exit 0
