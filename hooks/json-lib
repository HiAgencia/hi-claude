# Shared JSON helpers for hi-claude hooks. Sourced, never executed directly.
# No jq: the plugin ships with zero dependencies.

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# json_str <payload> <key> — first string value for that key.
# tool_input serializes file_path/command before content, so a key embedded
# in the content cannot shadow the real one.
#
# The value may contain ESCAPED QUOTES, so it cannot be read as "up to the next quote": with `[^"]*`
# the value is cut at the first `\"`, which truncates every Bash command carrying quotes — and a
# truncated command matches no rule, so quoting the command evades every guarantee that reads it. The
# bench carries quoted Bash cases for that reason.
#
# Only `\"` is unescaped here: Windows paths arrive with DOUBLED backslashes and several call sites
# already collapse them themselves, so touching `\\` would break the contract they rely on.
json_str() {
    printf '%s' "$1" \
      | grep -oE "\"$2\"[[:space:]]*:[[:space:]]*\"(\\\\.|[^\"\\\\])*\"" \
      | head -n 1 \
      | sed -E 's/^[^:]*:[[:space:]]*"//; s/"$//' \
      | sed 's/\\"/"/g'
}

emit_context() {
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "%s",\n    "additionalContext": "%s"\n  }\n}\n' \
      "$1" "$(escape_for_json "$2")"
}

emit_decision() {
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "PreToolUse",\n    "permissionDecision": "%s",\n    "permissionDecisionReason": "%s"\n  }\n}\n' \
      "$1" "$(escape_for_json "$2")"
}
