#!/usr/bin/env bash
# PreToolUse policy for hi-claude.
#
#   1. A SUBAGENT never decides what gets done and never touches the project's artefacts. It may
#      read, inspect, test and measure - that is its job. Anything it writes outside a clearly
#      temporary location is denied, through ANY tool, and so is delegating the work onward.
#      There is no environment-variable escape: a switch nobody can see in the session is a hole
#      with a name. The visible escape is disabling the plugin.
#   2. Anyone writing a governed file (CLAUDE.md / persistent memory) -> ask.
#   3. Anyone writing markdown -> the writing rules, in one line, with the skill that holds them.
#      Writing prose has no decision point where a skill feels required, so as a skill description
#      alone the rules do not arrive. It is a guarantee or it is nothing.
#
# Everything else passes through untouched (empty output, exit 0). The evidence behind each rule
# lives in the maintainers' eval reports; the comments here carry the invariant.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/json-lib"

input=$(cat)

tool=$(json_str "$input" tool_name)
agent_id=$(json_str "$input" agent_id)
file_path=$(json_str "$input" file_path)
command=$(json_str "$input" command)
cwd=$(json_str "$input" cwd)
session=$(json_str "$input" session_id)
# The TURN key. Present on the common input fields; when it is absent the per-turn consultation
# degrades to per-write, which is the safe direction and is asserted by the bench.
prompt_id=$(json_str "$input" prompt_id)

DENY="hi-claude: a subagent investigates - it never decides what gets done and never touches the project's artefacts. Report what you saw as a HYPOTHESIS with its evidence (file:line). The main agent that dispatched you reads it, verifies it first-hand and makes the change."

# Normalize a path: JSON doubles backslashes; unify separators, collapse dupes, lowercase.
norm() { printf '%s' "$1" | tr '\\' '/' | sed 's#//*#/#g' | tr '[:upper:]' '[:lower:]'; }

# Every file_path in the payload. Key order inside tool_input is model-controlled, so a governed
# path could sit in a later occurrence than the one json_str returns. Missing a decision is the
# costly error; an extra one is not. Test EVERY occurrence.
all_paths=$(printf '%s' "$input" \
  | grep -o '"[a-z_]*path[a-z_]*"[[:space:]]*:[[:space:]]*"[^"]*"' \
  | sed 's/.*:[[:space:]]*"\(.*\)"/\1/')

# A destination a subagent may write: clearly temporary, never a project artefact.
#
# THE NULL SINK IS NOT A DESTINATION. Discarding output is the opposite of writing, and leaving it out
# denies every read that carries `2>/dev/null` - which, under a method that sends command output to a
# file or to the void, is most of what a subagent runs.
is_temp() {
  case "$(norm "$1")" in
    /dev/null|/dev/stdout|/dev/stderr|nul|nul:) return 0 ;;
    /tmp/*|/var/tmp/*|*/appdata/local/temp/*|*/scratchpad/*|*/.cache/*|*.tmp) return 0 ;;
  esac
  return 1
}

# A COMMAND IS NOT ONE COMMAND. `cd X && rm y ; R="Z"` is three, and a decision taken over the whole
# string attributes one segment's operator to another segment's arguments.
#
# The payload carries JSON-ESCAPED quotes, so quoted arguments read as `\"a b\"`. Un-escape first or
# every quoted path is parsed with its backslash and matches nothing that exists.
# A separator INSIDE quotes is text, not a separator: splitting on it fabricates a segment that was
# never a command.
segments_of() {
  printf '%s' "$1" | sed 's/\\"/"/g' | awk -v SQ="'" '
    {
      n = length($0); s = ""; q = 0; qc = ""
      for (i = 1; i <= n; i++) {
        c = substr($0, i, 1)
        if (q) { s = s c; if (c == qc) q = 0; continue }
        if (c == "\"" || c == SQ) { q = 1; qc = c; s = s c; continue }
        if (c == ";") { print s; s = ""; continue }
        if (c == "|") { if (substr($0, i + 1, 1) == "|") i++; print s; s = ""; continue }
        if (c == "&" && substr($0, i + 1, 1) == "&") { i++; print s; s = ""; continue }
        s = s c
      }
      print s
    }'
}

# Split respecting quotes: paths carry spaces, and splitting on whitespace alone turns one path into
# two tokens that match nothing.
tokens_of() {
  printf '%s' "$1" \
    | grep -oE '"[^"]*"|'"'"'[^'"'"']*'"'"'|[^[:space:]]+' \
    | sed -e 's/^"//; s/"$//' -e "s/^'//; s/'\$//"
}

# The ARGUMENTS of a segment: its head and its flags are not paths.
args_of() {
  tokens_of "$1" | { read -r _head; while IFS= read -r t; do
    case "$t" in -*|"") continue ;; esac
    printf '%s\n' "$t"
  done; }
}

# ---------------------------------------------------------------- 1. subagent
if [ -n "$agent_id" ]; then

  # 1a. Session-local scratch is not a project artefact. Matching is an UNANCHORED regex, so the
  #     matcher above also catches TodoWrite, and the allowlist below would deny it. Denying a
  #     subagent its own todo list is friction, not protection.
  case "$tool" in
    TodoWrite|TaskGet|TaskList|TaskOutput) exit 0 ;;
  esac

  # 1b. Delegating the work onward is still doing it.
  case "$tool" in
    Agent|Task|TaskCreate|TaskUpdate|Workflow)
      emit_decision deny "$DENY"; exit 0 ;;
  esac

  # 1c. Known writing tools: allowed only when EVERY destination is temporary.
  case "$tool" in
    Write|Edit|NotebookEdit)
      targets="$file_path
$all_paths"
      while IFS= read -r p; do
        [ -n "$p" ] || continue
        is_temp "$p" || { emit_decision deny "$DENY"; exit 0; }
      done <<EOF
$targets
EOF
      exit 0 ;;
  esac

  # 1d. Bash: an allowlist, not a pattern hunt. Detecting writes by pattern always trails the
  #     next command that writes (python -c, node -e, cp). Read and test commands pass; the
  #     rest is denied. A project widens it by listing prefixes in .claude/hi-claude-runners.
  if [ "$tool" = "Bash" ]; then
    # Any redirection to a non-temporary destination is a write, whatever the command is.
    for dest in $(printf '%s' "$command" | grep -oE '>>?[[:space:]]*[^ &|;<>]+' | sed 's/^>*[[:space:]]*//'); do
      is_temp "$dest" || { emit_decision deny "$DENY"; exit 0; }
    done

    extra=""
    [ -n "$cwd" ] && [ -f "$(printf '%s' "$cwd" | sed 's#\\\\#\\#g')/.claude/hi-claude-runners" ] \
      && extra=$(cat "$(printf '%s' "$cwd" | sed 's#\\\\#\\#g')/.claude/hi-claude-runners" 2>/dev/null)

    bad=""
    while IFS= read -r seg; do
      seg=$(printf '%s' "$seg" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      [ -n "$seg" ] || continue
      # A project-declared runner prefix wins before anything else.
      matched=""
      while IFS= read -r pref; do
        [ -n "$pref" ] || continue
        case "$seg" in "$pref"*) matched="yes" ;; esac
      done <<EOF
$extra
EOF
      [ -n "$matched" ] && continue
      # A READ COMMAND WITH A WRITE FLAG IS A WRITE COMMAND. The allowlist admits linters and test
      # runners by their SUBCOMMAND, and several of them rewrite the source when asked (`--fix`,
      # `--write-locks`). The subcommand is not the whole contract.
      case " $seg " in
        *" --fix"*|*" --write"*|*" -w "*|*" --apply"*|*" --in-place"*|*" --save"*|*" --force"*|\
        *" --write-locks"*|*" --update-snapshot"*|*" -u "*|*" --overwrite"*)
          bad="yes"; continue ;;
      esac
      # shellcheck disable=SC2086
      set -- $seg
      case "${1:-}" in
        ls|cat|head|tail|grep|rg|find|wc|which|where|echo|pwd|file|stat|sort|uniq|cut|tr|diff|basename|dirname|realpath|printenv|date|du|df|column|jq|yq|tree|env|test|true|cd|export)
          ;;
        git)
          case "${2:-}" in
            status|log|diff|show|branch|remote|ls-files|ls-remote|blame|describe|rev-parse|shortlog|cat-file|tag|config) ;;
            *) bad="yes" ;;
          esac ;;
        pytest|jest|vitest|mocha|rspec|phpunit|tox|nox)
          ;;
        cargo|go|dotnet|mvn|gradle)
          case "${2:-}" in test|check|vet|clippy) ;; *) bad="yes" ;; esac ;;
        npm|yarn|pnpm)
          case "${2:-} ${3:-}" in
            "test "*|"audit "*|"ls "*|"run test"|"run lint"|"run typecheck"|"run check") ;;
            *) bad="yes" ;;
          esac ;;
        *) bad="yes" ;;
      esac
    done <<EOF
$(segments_of "$command")
EOF
    [ -n "$bad" ] && { emit_decision deny "$DENY"; exit 0; }
    exit 0
  fi

  # 1e. MCP and anything else: an ALLOWLIST of reading, not a blocklist of mutation. A blocklist is
  #     always one verb behind - a tool that runs arbitrary code matches no mutation verb. Same lesson
  #     as the Bash policy: a tool whose name does not state that it READS is denied, which is the
  #     safe side of an unknown.
  case "$(printf '%s' "$tool" | tr '[:upper:]' '[:lower:]')" in
    *get*|*list*|*read*|*search*|*query*|*fetch*|*find*|*resolve*|*describe*|*show*|*view*|*inspect*|*diagnos*|*status*|*docs*|*lookup*|*explain*|*count*|*check*)
      exit 0 ;;
    *)
      emit_decision deny "$DENY"; exit 0 ;;
  esac
fi

# -------------------------------------------------- 2. the main agent DISPATCHING
# The delegation protocol has to arrive HERE, at the dispatch: dispatching has no decision point where
# a skill feels required - the model simply dispatches. It is a guarantee or it is nothing.
case "$tool" in
  Agent|Task|Workflow)
    emit_context PreToolUse "hi-claude: delegate the LOOKING, never the DECIDING - and never the change itself, not even an additive one. Ask for evidence you can check (file:line, the command that reproduces). What comes back is a HYPOTHESIS: read it whole, verify it first-hand before anything rests on it, and own the decision in your own words. Full protocol: the hi-claude:delegation skill."
    exit 0 ;;
esac

# ------------------------------------------- 3. long jobs belong in the background
# A command that runs for minutes blocks the session on a wait it could spend working. The call is
# the only moment it can still be changed, and it sits BEFORE the write checks on purpose: a test
# run writes nothing, so anything after them never sees it.
if [ "$tool" = "Bash" ]; then
  case "$command" in
    *run_in_background*) ;;
    *)
      printf '%s' "$command" | grep -Eq '(^|[;&|[:space:]])(pytest|jest|vitest|mocha|rspec|phpunit|tox|nox|gradle|mvn|terraform)([[:space:]]|$)|docker[[:space:]]+(build|compose)|npx[[:space:]]+playwright|run-evals|(npm|yarn|pnpm)[[:space:]]+(test|install|ci|run[[:space:]]+(test|build|e2e|lint))|(cargo|go|dotnet)[[:space:]]+(test|build)|(^|[[:space:]])make([[:space:]]|$)' \
        && { emit_context PreToolUse "hi-claude: this reads as a job that runs for minutes. Prefer run_in_background, with its FULL output going to a file - never piped through tail or head, which replaces its exit code and cuts the field that answers the question - and keep working on whatever that run does not read: \"it is running\" is not a waiting state. If it loads the machine or is about to be re-launched, the hi-claude:heavy-runs skill holds the rules. Foreground only when the very next step needs its output."; exit 0; }
      ;;
  esac
fi

# --------------------------------------- 3b. deleting what git does NOT keep
# "It leaves the tree and git keeps it" is what makes pruning safe to do. It does not hold for a file
# git never tracked: there is no copy, deleting is irreversible, and a generated mirror looks exactly
# like an irreplaceable original in the explorer. So the decision stops being hygiene and becomes the
# user's. Files that ARE tracked pass untouched - that is the common case and it stays frictionless.
#
# THE WHOLE THING IS SCOPED TO A REPO, because the doctrine it patches governs the PROJECT's material
# and nothing else: `ls-files` cannot tell "inside a repo and ignored" from "no repo here", and only
# the first one is what this was built for.
#
# QUOTED SEGMENTS FIRST, then the rest. Splitting the whole command on whitespace breaks any path
# carrying spaces, and the damage is not silence: a fragment of the broken path can still match
# something that exists, so the ask fires naming the WRONG token.
if [ "$tool" = "Bash" ]; then
  case "$command" in
    *rm\ *|*"Remove-Item"*|*unlink\ *)
      unsaved=""
      # ONLY the arguments of a DELETING segment: scanning the whole command attributes the `rm` to
      # tokens that belong to other statements.
      cands=""
      while IFS= read -r seg; do
        [ -n "$seg" ] || continue
        # shellcheck disable=SC2086
        set -- $seg
        case "${1:-}" in
          rm|unlink|del|Remove-Item) cands="${cands}$(args_of "$seg")
" ;;
        esac
      done <<SEGMENTS
$(segments_of "$command")
SEGMENTS
      while IFS= read -r cand; do
        [ -n "$cand" ] || continue
        # A token made only of separators is not a path: on Windows `\` IS the drive root and passes
        # `-e`, which turns a broken parse into a confident wrong answer.
        case "$(printf '%s' "$cand" | tr -d '\\/. ')" in "") continue ;; esac
        [ -e "$cand" ] || continue
        is_temp "$cand" && continue
        # THE PREMISE ONLY HOLDS INSIDE A REPO. A path under no repo at all was never covered by "git
        # keeps it", so quoting that rule at it says nothing - and `ls-files` comes back empty both for
        # an ignored file inside a repo and for a path git was never going to see. An environment with
        # no git at all lands in this same branch, which is the right place for it: nothing can be
        # checked there, and asking on every delete is noise, not protection.
        holder="$cand"
        [ -d "$cand" ] || holder=$(dirname "$cand")
        git -C "$holder" rev-parse --git-dir >/dev/null 2>&1 || continue
        # A DIRECTORY is never a pathspec `ls-files --error-unmatch` can match, so asking that way
        # reports every tracked directory as untracked. A directory counts as saved when git tracks
        # anything inside.
        if [ -d "$cand" ]; then
          [ -n "$(git -C "$cand" ls-files 2>/dev/null | head -n 1)" ] && continue
        else
          git -C "$(dirname "$cand")" ls-files --error-unmatch -- "$cand" >/dev/null 2>&1 && continue
        fi
        unsaved="${unsaved}${cand} "
      done <<EOF
$cands
EOF
      if [ -n "$unsaved" ]; then
        emit_decision ask "hi-claude: this sits INSIDE the repo and git does not track it, so there is NO copy and deleting is irreversible - the rule 'it leaves the tree, git keeps it' does not cover it: ${unsaved}. Look at the CONTENT before confirming: a generated mirror whose source is still alive loses nothing, an original without a backup is lost whole, and the two look identical in the explorer."
        exit 0
      fi ;;
  esac
fi

# ------------------------------------------------- 4. governed files (anyone)
# WHAT COUNTS AS WRITING A GOVERNED FILE. For Write/Edit/NotebookEdit the destination is explicit and
# the test is exact. For Bash there is no file_path, and testing the command TEXT confuses MENTIONING
# a file with WRITING it: a `2>/dev/null` or the `<noreply@…>` of a commit trailer supplies a `>`, and
# `git log -- CLAUDE.md > hist.txt` is a READ.
#
# So Bash is decided by the DESTINATION of a write operator. `git` cannot edit file content, and a
# mention inside a commit message is not a write. The one case a destination cannot express - an
# interpreter writing from inside its own code - keeps asking on the mention, because there the target
# is not in the text and narrowing it would be a guarantee that turns off without saying so.
governed_path() {
  case "$(norm "$1")" in
    *claude.md|*claude.local.md|*memory.md)  return 0 ;;
    */.claude/projects/*/memory/*.md)        return 0 ;;
  esac
  return 1
}

# Every destination a Bash command writes to. One per line, empty when it writes nothing.
bash_write_targets() {
  local cmd seg head
  cmd=$(printf '%s' "$1" | sed 's/\\"/"/g')

  # A redirection destination counts whatever the command is: `git log > CLAUDE.md` overwrites it.
  # `2>&1` is excluded by the class - the char after `>` may not be `&`, which is what makes a
  # stderr merge stop counting as a write.
  printf '%s' "$cmd" \
    | grep -oE '[0-9]?>>?[[:space:]]*("[^"]*"|'"'"'[^'"'"']*'"'"'|[^ &|;<>()]+)' \
    | sed -E 's/^[0-9]?>>?[[:space:]]*//' \
    | sed -e 's/^"//; s/"$//' -e "s/^'//; s/'\$//"

  while IFS= read -r seg; do
    [ -n "$seg" ] || continue
    # shellcheck disable=SC2086
    set -- $seg
    head="${1:-}"
    case "$head" in
      # The destination is an ARGUMENT, not a redirection. Testing every token is deliberate: the
      # flag order is the caller's and a positional destination has no marker to anchor on.
      # `sed` writes ONLY with -i: listing it unconditionally turns `sed -n '83p' CLAUDE.md` - a
      # READ - into a confirmation, which is the same mention-vs-write confusion one level down.
      sed)
        case " $seg " in *" -i"*) tokens_of "$seg" ;; esac ;;
      # `patch` and `xargs` write a governed file with no redirection in sight:
      # `patch CLAUDE.md < d.diff`, `xargs -I{} cp {} CLAUDE.md`.
      tee|cp|mv|rm|unlink|truncate|dd|install|ln|patch|xargs|\
      Set-Content|Add-Content|Out-File|Remove-Item|Move-Item|Copy-Item|New-Item)
        tokens_of "$seg" ;;
      # An interpreter writes from inside its own code, where no destination is readable. The mention
      # is all there is, so the mention is what decides - narrow to interpreters so it stays rare.
      python|python3|py|node|ruby|perl|php|pwsh|powershell|sh|bash|zsh)
        case "$(norm "$seg")" in
          *claude.md*|*claude.local.md*|*memory.md*|*/memory/*.md*) printf '%s\n' "$seg" ;;
        esac ;;
    esac
  done <<SEGMENTS
$(segments_of "$1")
SEGMENTS
}

targets=""
case "$tool" in
  Write|Edit|MultiEdit|NotebookEdit)
    targets="$file_path
$all_paths" ;;
  Bash)
    targets=$(bash_write_targets "$command") ;;
  *) exit 0 ;;
esac
[ -n "$(printf '%s' "$targets" | tr -d '[:space:]')" ] || exit 0

# Read line by line: paths carry spaces, and word-splitting them would break the patterns above.
governed=""
while IFS= read -r candidate; do
  [ -n "$candidate" ] || continue
  # The interpreter branch emits a whole segment, not a path: fall back to the substring test there.
  if governed_path "$candidate"; then governed="yes"; break; fi
  case "$(norm "$candidate")" in
    *claude.md*|*claude.local.md*|*memory.md*|*/memory/*.md*)
      case "$candidate" in *[[:space:]]*) governed="yes"; break ;; esac ;;
  esac
done <<EOF
$targets
EOF

if [ -n "$governed" ]; then
  is_memory=""
  case "$(norm "$file_path")" in */memory/*.md) is_memory="yes" ;; esac

  # ONE CONSULTATION PER TURN, and the two governed files earn it differently.
  #
  # CLAUDE.md loses nothing: many fragments are LESS reviewable than the whole file, so the demand is
  # the change in ONE write and the guarantee stays whole. Memories cannot be merged that way - nine
  # memories are nine files - so there the consultation covers the BATCH: the first one demands the
  # whole list up front and the rest of the turn rides it. That is the consultation axis loosened on
  # purpose, with the user's word, and only for memories.
  #
  # The turn key is `prompt_id`. Without it there is no turn to key on, so it degrades to asking every
  # time - the safe side - and the bench covers BOTH branches, because a guarantee that switches off
  # without saying so is the exact failure this file exists to prevent.
  if [ -n "$is_memory" ] && [ -n "$prompt_id" ] && [ -n "$session" ]; then
    if [ -f "${TMPDIR:-/tmp}/hi-claude-mem-${session}-${prompt_id}" ]; then
      emit_context PreToolUse "hi-claude: this memory rides the consultation already approved for this turn, which covered a LIST. If this one was not on that list, stop and propose it on its own - approval of a batch is not approval of whatever comes after it. Creating a new memory is still the LAST option: if one already carries the rule, extend THAT one."
      exit 0
    fi
  fi

  # A memory that does not exist yet is the moment MERGING is still cheap: memories pile up as one
  # rule stated against many objects. The neighbours are named by shared word - crude on purpose,
  # because the cost of naming one too many is a line, and the cost of naming none is one more memory.
  extra=""
  real=$(printf '%s' "$file_path" | tr '\\' '/' | sed 's#//*#/#g')
  case "$(norm "$real")" in
    */memory/*.md)
      if [ -n "$real" ] && [ ! -f "$real" ]; then
        dir=$(dirname "$real")
        base=$(basename "$real" .md)
        near=""
        for w in $(printf '%s' "$base" | tr '-' '\n' | awk 'length($0)>=4'); do
          for other in "$dir"/*.md; do
            [ -f "$other" ] || continue
            ob=$(basename "$other" .md)
            [ "$ob" = "$base" ] && continue
            [ "$ob" = "MEMORY" ] && continue
            case "$ob" in
              *"$w"*) case " $near " in *" $ob "*) ;; *) near="${near}${ob} " ;; esac ;;
            esac
          done
        done
        [ -n "$near" ] && extra=" This memory does not exist yet. MERGING beats adding and creating a new one is the LAST option - these already share a word with it: ${near}. Open them first: if one already carries the rule, extend THAT one instead."
      fi ;;
  esac
  # THE CONSULTATION CARRIES THE ADMISSION QUESTIONS. Asking only to "confirm the change" turns approval
  # into a formality over the FORM, and what then gets approved is whatever was proposed. The three
  # questions are what the user is actually ruling on, so they sit in the dialog itself.
  admission="ADMISSION, before confirming: (1) did the USER state this as a preference or a limit? (2) will it still be true in five months - no date, no figure from one run, no account of the case that produced it? (3) is it the RULE, with its evidence left in docs/ and only its path here? A no on any of them means it does not go in."
  if [ -n "$is_memory" ]; then
    emit_decision ask "hi-claude guard: this writes to persistent memory. ${admission} THIS CONSULTATION COVERS THE WHOLE TURN: if you intend to write more memories now, LIST THEM ALL HERE - name and content of each - because the rest of the turn will ride this approval and what was not listed was not approved.${extra}"
  else
    emit_decision ask "hi-claude guard: this writes to a governed file (CLAUDE.md). ${admission} APPLY THE WHOLE CHANGE IN ONE WRITE: every separate edit costs the user another confirmation, and a whole file is more reviewable than its fragments. If more changes to this file remain, compose them and write once.${extra}"
  fi
  exit 0
fi

# ------------------------------------------------------------ 5. markdown nudge
# Short on purpose: it rides along on every doc write.
#
# The BELONGING map rides along too, but ONLY when the destination does not exist yet. Writing into a
# document already declared emits nothing: a signal that shows up on ordinary work is one that gets
# learnt away, and creating a file is the only moment where the destination is still free. The map is
# what EXISTS under docs/, not what an index declares - a session can only reuse what is really there.
md=""
while IFS= read -r candidate; do
  [ -n "$candidate" ] || continue
  case "$(norm "$candidate")" in *.md) md="yes"; break ;; esac
done <<EOF
$targets
EOF

case "$md" in
  yes)
    map=""
    real=$(printf '%s' "$file_path" | tr '\\' '/' | sed 's#//*#/#g')
    # A TEMPORARY destination is not a project document, so it gets no destination map.
    if [ -n "$real" ] && [ ! -e "$real" ] && ! is_temp "$real"; then
      docs="$(printf '%s' "$cwd" | sed 's#\\\\#\\#g' | tr '\\' '/' | sed 's#//*#/#g')/docs"
      if [ -d "$docs" ]; then
        dests=""
        for f in "$docs"/*.md; do
          [ -f "$f" ] || continue
          dests="${dests}docs/$(basename "$f") "
        done
        for d in "$docs"/*/; do
          [ -d "$d" ] || continue
          dests="${dests}docs/$(basename "$d")/ "
        done
        [ -n "$dests" ] && map=" CREATING a document is the LAST option - what comes up goes into an existing one, and any pair that can be merged is merged. Destinations already here: ${dests}. What is not opened session after session is CONTEXT and lives together in ONE place. If none of these owns it, say why in one line and declare the new file in CLAUDE.md in this same turn: a document the orchestrator does not name is one no session opens."
      fi
    fi
    # A DOCUMENT IS EDITED WITH THE EDIT TOOL. A script - `sed -i`, an interpreter, a redirection -
    # hits the line and misses the meaning, and nobody can review the change until it is done. Moving,
    # copying and deleting are not editing, so those heads stay out.
    script=""
    if [ "$tool" = "Bash" ]; then
      case " $(printf '%s' "$command" | sed 's/\\"/"/g') " in
        *" sed "*|*" awk "*|*" perl "*|*"python"*|*" node "*|*">"*".md"*)
          script=" A DOCUMENT IS EDITED WITH THE EDIT TOOL, NEVER WITH A SCRIPT: a splice by line number or a regex pass cannot be reviewed before it lands. If the change feels too big for the edit tool, it is several changes." ;;
      esac
    fi
    # ONCE PER TURN. A turn that edits twenty documents needs the rules once: repeated on every write
    # they are the signal that shows up on ordinary work and gets learnt away. The map and the script
    # rule are about THIS write, so they still ride along on their own. Without a turn key it repeats,
    # which is the safe side.
    rules="hi-claude: written work here is TIMELESS and NON-CONDITIONING - no dates, no \"for now\", no verdict that closes a door (ceiling, impossible, definitive), and no doc that turns into a chronicle. OBJECTIVE: the fact with its evidence, never a grade or an attributed cause. THE RULE TRAVELS WITHOUT ITS HISTORY: a figure, its N and the case behind a rule live in the evidence document, not glued to the rule. Full rules: the hi-claude:work-protocol skill."
    if [ -n "$prompt_id" ] && [ -n "$session" ]; then
      seen="${TMPDIR:-/tmp}/hi-claude-md-${session}-${prompt_id}"
      if [ -f "$seen" ]; then
        rules=""
        [ -n "${map}${script}" ] && rules="hi-claude:"
      else
        : > "$seen" 2>/dev/null
      fi
    fi
    [ -n "$rules" ] && emit_context PreToolUse "${rules}${map}${script}"
    ;;
esac

exit 0
