#!/usr/bin/env bash
# PreToolUse policy for hi-claude.
#   1. A subagent trying to WRITE anything -> deny (it investigates, it does not implement).
#   2. Anyone writing a governed file (CLAUDE.md / persistent memory) -> ask.
#   3. Anyone writing markdown -> the writing rules, in one line, with the skill that holds them.
#      Measured: as a skill description alone this never fired, because writing prose has no
#      decision point where a skill feels required. It is a guarantee or it is nothing.
# Everything else passes through untouched (empty output, exit 0).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/json-lib"

input=$(cat)

tool=$(json_str "$input" tool_name)
agent_id=$(json_str "$input" agent_id)
file_path=$(json_str "$input" file_path)
command=$(json_str "$input" command)

# Does this call write anything?
writes=""
case "$tool" in
  Write|Edit|MultiEdit|NotebookEdit) writes="yes" ;;
  Bash)
    printf '%s' "$command" \
      | grep -Eq '>>?[[:space:]]*[^ &|]|\btee\b|\bsed\b[^|]*-i|\bSet-Content\b|\bAdd-Content\b|\bOut-File\b|\btruncate\b' \
      && writes="yes"
    ;;
esac

# 1. Subagents investigate; they do not implement.
# agent_id is present only when the hook fires inside a subagent call
# (measured on Claude Code 2.1.220 — see the internal repo's agent-id probe).
if [ -n "$agent_id" ] && [ -n "$writes" ] && [ "${HI_CLAUDE_SUBAGENT_WRITES:-0}" != "1" ]; then
  emit_decision deny "hi-claude: a subagent investigates, it does not implement. What it brings is a hypothesis - the main agent verifies it first-hand and makes the change. Set HI_CLAUDE_SUBAGENT_WRITES=1 to allow."
  exit 0
fi

# 2. Governed files. Only when the call actually writes.
[ -n "$writes" ] || exit 0

target="$file_path"
[ -z "$target" ] && target="$command"
[ -z "$target" ] && exit 0

# Normalize: JSON doubles backslashes; unify separators, collapse dupes, lowercase.
normalized=$(printf '%s' "$target" | tr '\\' '/' | sed 's#//*#/#g' | tr '[:upper:]' '[:lower:]')

governed=""
case "$normalized" in
  *claude.md*|*claude.local.md*|*memory.md*) governed="yes" ;;
  *.claude/projects/*/memory/*.md*)          governed="yes" ;;
esac

if [ -n "$governed" ]; then
  emit_decision ask "hi-claude guard: this writes to a governed file (CLAUDE.md / persistent memory). Review and confirm the exact change."
  exit 0
fi

# 3. Markdown gets the writing rules. Short on purpose: it rides along on every doc write.
case "$normalized" in
  *.md|*.md\ *|*.md\"*|*.md\'*)
    emit_context PreToolUse "hi-claude: written work here is TIMELESS - no dates, no \"for now\", no verdicts written as final, and no doc that turns into a chronicle of what changed. A measured result is a datum with its N, reopenable. Full rules: the hi-claude:work-protocol skill."
    ;;
esac

exit 0
